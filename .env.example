# Secret used to sign session cookies. Use a long random string in production.
JWT_SECRET=
# Port for the API server (and the built app in production).
PORT=3001
# Path to the SQLite database file.
DATABASE_PATH=./data/collect.db
# When "true", shows the demo clock control so reviewers can test inside the 8 am - 7 pm window.
DEMO_MODE=true
